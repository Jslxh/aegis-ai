# ============================================================================
# Guardrail AI - environment configuration
#
# Copy this template to `.env` and adjust the values:
#
#   cp .env.example .env
#
# `.env` is git-ignored and is never committed. For production (Lambda) you must
# set POSTGRES_PASSWORD and GROQ_API_KEY.
# ============================================================================

# --- Application ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

# --- PostgreSQL -------------------------------------------------------------
# Credentials used to bootstrap the Postgres container (POSTGRES_*) and the
# connection string the API/migrations use. In Docker Compose the host is the
# service name (`db`); change it to `localhost` when running without Docker.
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=guardrail
POSTGRES_DB=guardrail
POSTGRES_PORT=5432
DATABASE_URL=postgresql://guardrail:guardrail@localhost:5432/guardrail

# SQLAlchemy tuning (optional)
# DB_ECHO=false
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# --- Groq AI (optional) -----------------------------------------------------
# AI endpoints (/ai/*) return 503 when no key is configured.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenTelemetry (optional) ------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=guardrail-ai

# --- Prometheus metrics ------------------------------------------------------
PROMETHEUS_ENABLED=true
METRICS_NAMESPACE=guardrail

# --- Policies / plugins -------------------------------------------------------
POLICY_FILE=configs/default.yaml
# Comma-separated extra plugin directories (optional)
GUARDRAIL_PLUGIN_DIRS=
